# Задание 3: инвесторы Майкл и Иван

# Вводим суммы
X = int(input("Введите минимальную сумму инвестиций (X): "))
A = int(input("Введите сумму Майкла (A): "))
B = int(input("Введите сумму Ивана (B): "))

# Проверяем условия по порядку
if A >= X and B >= X:
    print(2)             # оба могут вложиться самостоятельно
elif A >= X and B < X:
    print("Mike")        # только Майкл
elif A < X and B >= X:
    print("Ivan")        # только Иван
elif A + B >= X:
    print(1)             # по отдельности не могут, но вместе хватает
else:
    print(0)             # ни вместе, ни по отдельности
